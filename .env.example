# 账户状态文件、目录或逗号分隔的多个路径
AISTUDIO_AUTH_STATES=auth

# 服务监听地址
LISTEN_ADDR=127.0.0.1:2048

# API 试用页 HTML 预览的监听地址，端口与 LISTEN_ADDR 不同
PREVIEW_LISTEN_ADDR=127.0.0.1:2050

# 本地 API 认证密钥，多个 key 用逗号分隔
# 可在 Web 门户修改并立即生效；保存后的密钥不再被进程环境变量覆盖
# Web 修改密钥时自动写入 PROXY_API_KEY_WEB_OVERRIDE=true，重启后仍使用保存的密钥
PROXY_API_KEY=

# 各 key 可用的账户，每项写成 key:账户|账户，逗号分隔多项；未列出的 key 可用全部账户
# 保存后立即生效，环境变量设置时只读；格式无效会拒绝加载，避免放开账户范围
API_KEY_ACCOUNTS=

# 管理程序启动后自动启动生成服务，修改后重启程序生效
AUTO_START=false

# macOS 桌面版只在菜单栏显示图标、不显示 Dock 图标，在设置页修改立即生效
HIDE_DOCK_ICON=false

# 保存公开 API 的 POST 请求与响应正文，各截断到 64 KiB，只保留最近 1000 条，保存后立即生效
REQUEST_BODY_LOG=false

# 同时把服务日志写入 runtime/logs/，单文件 10 MB 轮转，保存后立即生效
LOG_FILE=true

# 日志目录总量上限（MB），超出时删除最旧的文件，不小于 20
LOG_MAX_TOTAL_MB=500

# 管理控制台登录，修改后重启程序生效
ADMIN_AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# setup 与未指定账户共同使用的 HTTP、HTTPS 或 SOCKS5 代理，多个代理用逗号分隔组成代理池
PROXY=

# 单账户初始化超时
INIT_TIMEOUT=2m

# 普通请求最大执行时间
REQUEST_TIMEOUT=30m

# 常驻预热账户数；0 为按需启动，空闲 30 秒后释放全部 Worker
WARM_WORKER_LIMIT=0

# 高峰期最多同时运行的 Worker 数
MAX_ACTIVE_WORKERS=1

# 同时冷启动的 Worker 数；两种后端均适用，设为 1 降低峰值内存
WARM_STARTUP_CONCURRENCY=1

# 单账号同时处理的请求数
PER_ACCOUNT_CONCURRENCY=1

# 账户选择策略：round-robin 或 fill-first
ROUTING_STRATEGY=round-robin

# fill-first 依次使用的账户 ID，逗号分隔，未列出的账户排在后面并按 ID 排序，保存后立即生效
ACCOUNT_ORDER=

# 上游返回 403、5xx 等非额度错误时一个请求最多换几次账户重试，0 为不换号；额度用尽不计入
MAX_ACCOUNT_SWITCHES=3

# 启用的上游通道：playground、build，逗号分隔；固定 URL 不跨通道回退
# /v1 固定 Playground；/build/v1 固定 Build；/v1beta 自动路由
# Build 为旧代理通道，上游已停用其生成；本示例只启用 Playground，省略配置时默认启用两个通道
UPSTREAM_CHANNELS=playground

# 客户端模型名到目录模型 ID 的映射，每项写成 别名:模型 ID，逗号分隔多项
MODEL_MAPPING=

# 限定模型只走一个上游通道，每项写成 模型 ID:playground 或 模型 ID:build，逗号分隔多项，保存后立即生效
MODEL_CHANNELS=

# 模型可用的账户，每项写成 模型 ID:账户|账户，逗号分隔多项，未列出的模型可用全部账户，保存后立即生效
MODEL_ACCOUNTS=

# 同步账户模型目录时找出 AI Studio 官网前端已配置、账户 ListModels 尚未列出的模型，经上游 CountTokens 确认可用后加入目录并可直接请求；被 ListModels 列出后使用官方条目
DISCOVER_HIDDEN_MODELS=false

# 自动路由的非流式请求优先 Build 原生单次调用；URL 固定通道优先
BUILD_NATIVE_NONSTREAM=false

# 非流式请求等待超过 10 秒时先返回 200，之后每 10 秒写出一个换行，经反向代理时连接不会因长时间无数据断开
NONSTREAM_KEEPALIVE=true

# 流式请求先按非流式取得完整结果再按流式格式输出，中途失败时换号重发
FAKE_STREAM=false

# 用户消息文本中的 YouTube 链接作为视频发送给模型
YOUTUBE_LINKS=false

# 保留所有普通模型，为所有公开模型（含用户映射/搜索模型）增加 抗截断- 变体
# 仅前缀模型使用合成工具承载完整正文并还原输出；普通模型不受影响，与 AUTO_CONTINUATION 独立
# 默认关闭，关闭时不展示也不接受前缀模型；管理页保存后对新请求立即生效
ANTI_TRUNCATION=false

# 发往上游前去掉对话历史中的思考签名，函数调用带 skip_thought_signature_validator；之前各轮的思考内容不随签名发给模型，长对话的输入 token 较少
STRIP_THOUGHT_SIGNATURES=false

# 以 assistant 消息结尾的请求在不支持原生续写的模型上改写为续写请求；false 时原样发送，上游拒绝时返回其错误
CONTINUATION_REWRITE=false

# Playground 分轮自动续写；false 时即使上游要求续写也不再发送下一轮，与上面的输入前缀改写无关
# 管理页保存后立即生效，已发出的当前轮不会被中断
AUTO_CONTINUATION=false

# 改写时与末尾 assistant 消息一起写入系统指令的续写提示词；设为空时末尾 assistant 消息改作 user 消息发送
CONTINUATION_PROMPT="Continue the assistant response after the following prefix. Return only the continuation, without repeating the prefix."

# 原请求迟迟没有首字时用空闲账户（其他账户优先，没有时用原账户的空闲槽位）发起一个备用请求，先出首字的一方继续：off 关闭，auto 按各模型与通道近 24 小时首字等待的 p95，正整数为等待秒数
FIRST_EVENT_HEDGE=off

# 发起备用请求的模型 ID，逗号分隔；备用请求同样计入账户额度
FIRST_EVENT_HEDGE_MODELS=

# WAA 后端：spidermonkey（默认）在服务进程内执行；camoufox 使用完整浏览器页面
# 旧配置 go 自动迁移为 spidermonkey；HTTP Cookie 验证不需要浏览器
WAA_BACKEND=spidermonkey

# Chat Completions 与 Messages 正文中生成媒体的引用方式：inline 以 data URI 内联，url 保存到 runtime/media/ 并以本服务 URL 引用
MEDIA_OUTPUT=inline

# 媒体 URL 使用的服务地址，例如 https://ai.example.com；留空时使用每个请求访问的地址
MEDIA_BASE_URL=
